# Bu dosyayı .env.local olarak kopyalayın ve kendi değerlerinizi girin.
# .env.local Git'e eklenmez.

# Oturum çerezini imzalamak için rastgele, en az 32 karakterlik bir değer.
SESSION_SECRET=

# --- Demo modu (Supabase bağlanmadığında kullanılır) ---
# Tek yönetici girişi için e-posta ve bcrypt şifre hash'i (base64 kodlanmış).
# bcrypt hash'leri "$" karakteri içerdiğinden Next.js'in env genişletmesi
# (dotenv-expand) bunu bozar; bu yüzden hash düz değil, base64 ile saklanır.
# Üretmek için: npx tsx scripts/hash-password.ts "şifreniz"
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD_HASH_B64=

# --- Supabase (prod / gerçek veritabanı) ---
# Her ikisi de boş bırakılırsa uygulama otomatik olarak demo moduna düşer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bildirimler ---
# simulated: gerçek e-posta göndermez, yalnızca loga/veritabanına kaydeder.
# resend: gerçek gönderim için Resend API kullanır.
NOTIFICATIONS_MODE=simulated
EMAIL_FROM=
EMAIL_API_KEY=
# Hatırlatma e-postalarının gideceği adres (Supabase/canlı modda zorunlu;
# demo modda DEMO_ADMIN_EMAIL'e düşer).
ADMIN_EMAIL=

# Vercel Cron'un hatırlatma endpoint'ini çağırabilmesi için paylaşılan sır.
CRON_SECRET=
